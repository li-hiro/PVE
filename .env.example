# ---------------------------------------------------------------------------
# VirtGate 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 生产部署必须设置 JWT_SECRET 与 ENCRYPTION_KEY（可用 openssl rand -hex 32 生成）
# ---------------------------------------------------------------------------

# 运行环境：production 时强制校验 JWT_SECRET / ENCRYPTION_KEY
NODE_ENV=production

# 后端监听地址与端口（容器内）
HOST=0.0.0.0
PORT=8080

# SQLite 数据库文件路径；Docker 部署已挂载 /app/data 持久卷
DATABASE_PATH=/app/data/virtgate.db

# JWT 签名密钥（至少 32 字节随机串）
JWT_SECRET=change-me-to-a-random-32-byte-hex
# JWT 有效期，支持 8h / 24h / 7d 等
JWT_EXPIRES_IN=8h

# 集群 API Token 加密密钥（AES-256-GCM，建议 32 字节随机串）
ENCRYPTION_KEY=change-me-to-another-random-32-byte-hex

# 允许的跨域来源，逗号分隔；同源反向代理下可保持默认
CORS_ORIGINS=http://localhost:8088

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 演示模式：自动创建 Mock 集群与演示用户，生产环境请设为 false
DEMO_MODE=true

# 首次启动时内置平台管理员密码（仅在用户表为空时生效）
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
# 演示用户密码（DEMO_MODE=true 时生效）
DEMO_USER_PASSWORD=Demo@12345

# 集群同步：是否启用定时轮询与轮询间隔（秒）
SYNC_ENABLED=true
SYNC_INTERVAL_SEC=30

# 监控指标保留天数
METRICS_RETENTION_DAYS=7

# 控制台一次性会话有效期（秒）
CONSOLE_TTL_SEC=300

# 资源阈值告警（百分比）
ALERT_CPU_THRESHOLD=85
ALERT_MEM_THRESHOLD=90
ALERT_DISK_THRESHOLD=92

# 异常行为检测窗口与阈值
ANOMALY_WINDOW_MINUTES=10
ANOMALY_DESTRUCTIVE_BURST=3
ANOMALY_FAILURE_BURST=5
ANOMALY_DENIAL_BURST=3
ANOMALY_LOGIN_FAILURE_BURST=5

# 可选：告警 Webhook（POST JSON），留空表示不推送
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# docker compose 专用
# ---------------------------------------------------------------------------
# Web 门户对外端口（Nginx）
WEB_PORT=8088
